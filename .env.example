# Identyfikator formularza z panelu Forminit (forminit.com).
# To wartosc PUBLICZNA — trafia do kodu strony i kazdy moze ja podejrzec.
# Tak ma byc: tryb Public jest jedynym, ktory dziala ze strony statycznej.
# Adres odbiorcy zgloszen ustawia sie w panelu Forminit, nie tutaj.
#
# Skopiuj ten plik jako .env.local i wstaw wlasna wartosc.
VITE_FORMINIT_FORM_ID=
